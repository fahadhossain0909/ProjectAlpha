# ProjectAlpha Environment Template
# Copy to .env and replace ALL secret values before running production.
# NEVER commit .env or real credentials to Git.
#
# Conventions:
# - Normal variables below contain safe example values.
# - Secret variables are intentionally blank and include guidance on what to put there.
# - Generate secrets locally/VPS; do not copy example secrets into production.

# ============================================
# Application Environment
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO
REQUIRE_HUMAN_APPROVAL_FOR_PROD=true
DEBUG=false
TESTING=false

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Secret: use a long random Redis password (32+ random characters), e.g.
#   openssl rand -hex 32
REDIS_PASSWORD=

# ============================================
# ClickHouse Configuration
# ============================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
# Secret: use a unique long random ClickHouse password (32+ characters).
# Do not use the default/blank password in production.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=aitos
CLICKHOUSE_DB=aitos

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Secret: set a strong unique Neo4j password, preferably 32+ random characters.
# Example generator: openssl rand -hex 32
NEO4J_PASSWORD=

# ============================================
# Continual Learning
# ============================================
LEARNING_POLL_SECONDS=60
LEARNING_LOOKBACK_HOURS=168
LEARNING_MODEL_PATH=models/online_rl/deep_value.pkl
LEARNING_STATE_PATH=models/online_rl/worker_state.json

# ============================================
# Backtest / Historical Data
# ClickHouse is the preferred long-lived source. BACKTEST_DATA_DIR is only
# for optional local/Parquet replay and cache; it is not ingested automatically.
# ============================================
BACKTEST_DATA_DIR=./data

# ============================================
# Binance Trading Configuration
# Only needed for LIVE order execution (aitos.execution.binance_executor).
# Keep TESTNET=true until live trading is deliberately enabled.
# ============================================
# Secret: create a Binance API key with ONLY the permissions required by
# ProjectAlpha. Never put withdrawal permission on the trading key.
BINANCE_API_KEY=
# Secret: the API secret generated together with the Binance API key.
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW_MS=5000
BINANCE_HEDGE_MODE=false

# ============================================
# Deployment Configuration (GitHub Actions)
# ============================================
# Variable: public/private IP or DNS name of the deployment VPS.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
DEPLOY_PORT=22
APP_PORT=8000
APP_HOST=0.0.0.0

# ============================================
# Docker Compose / GHCR
# ============================================
COMPOSE_PROJECT_NAME=projectalpha
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your_github_username

# ============================================
# Application Security
# ============================================
# Secret: generate a high-entropy application signing key, e.g.
#   openssl rand -hex 32
SECRET_KEY=
# Secret: generate a separate random API key (do not reuse SECRET_KEY), e.g.
#   openssl rand -hex 32
API_KEY=
# Optional secret: only set if the application is configured to use an external
# database URL. Keep credentials out of source control.
DATABASE_URL=

# ============================================
# Deployment SSH Secret
# ============================================
# Secret: use the private SSH key corresponding to the deploy user's authorized
# public key. Store it in GitHub Actions Secrets, NOT in this .env file.
# Example format: -----BEGIN OPENSSH PRIVATE KEY----- ...
DEPLOY_SSH_PRIVATE_KEY=

# ============================================
# Third-Party Services (Optional)
# ============================================
# Secret: Sentry DSN supplied by the Sentry project settings.
SENTRY_DSN=
# Secret: Slack Incoming Webhook URL supplied by the Slack app/integration.
SLACK_WEBHOOK_URL=
